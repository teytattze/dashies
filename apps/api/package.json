{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:snowflake": "bun src/seed/snowflake.ts",
    "seed:datasource": "bun src/seed/datasource.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "postgres": "^4.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@hono/zod-validator": "^0.9.1",
    "ai": "^7.0.177",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  }
}
