DATABASE_URL=postgres://postgres:postgres@localhost:5432/dashies
# 32 random bytes, base64: openssl rand -base64 32
CREDENTIALS_KEY=
# For the AI that builds dashboards.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
AI_MODEL=

# Only for `bun run seed:snowflake`, which loads the sample USERS and TASKS
# tables for testing. It creates the schema if needed and REPLACES both
# tables in it, so use a schema of its own.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=DASHIES_TEST
# Optional.
SNOWFLAKE_ROLE=
# Programmatic access token of the Snowflake user.
SNOWFLAKE_TOKEN=
